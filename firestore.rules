rules_version = '2';

// Online rooms for every game on the site. There's no game server: each phone applies the
// rules itself, so these checks keep players honest about *who* may write and *when*.
//
// Every game's rooms have the same shape (see platform/rooms.ts) and live in the game's own
// collection. To add a game, add a `match /<collection>/{code}` block that calls the
// shared room functions below, plus anything extra that game needs.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // None of `keys` changed in this update.
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // The only change to the member list is the writer adding or removing themselves.
    function onlySelfJoinsOrLeaves() {
      let before = resource.data.memberUids.toSet();
      let after = request.resource.data.memberUids.toSet();
      return after.difference(before).hasOnly([request.auth.uid])
        && before.difference(after).hasOnly([request.auth.uid]);
    }

    // ---- Shared room rules ------------------------------------------------------------

    // Anyone signed in who knows the code can watch.
    function canReadRoom() {
      return signedIn();
    }

    // A new room starts as an empty lobby hosted by its creator.
    function canCreateRoom(code) {
      return signedIn()
        && code.matches('^[A-Z2-9]{5}$')
        && request.resource.data.code == code
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.version == 0
        && request.resource.data.memberUids == [request.auth.uid];
    }

    // Lobby: the host may change anything (including starting the game);
    // anyone else may only take or give up their own seat.
    function canEditLobby() {
      return signedIn()
        && resource.data.status == 'lobby'
        && unchanged(['code', 'hostUid', 'createdAt'])
        && (
          request.auth.uid == resource.data.hostUid
          || (
            request.resource.data.status == 'lobby'
            && unchanged(['settings', 'version', 'stateJson', 'replayJson', 'currentUid'])
            && onlySelfJoinsOrLeaves()
          )
        );
    }

    // Game: seated players only, one version at a time, and only by the player the last
    // save named (`currentUid`), or by anyone seated when it named no one (a bot's turn).
    function canPlayMove() {
      return signedIn()
        && resource.data.status == 'playing'
        && request.auth.uid in resource.data.memberUids
        && unchanged(['code', 'hostUid', 'createdAt', 'seats', 'memberUids', 'status', 'settings'])
        && request.resource.data.version == resource.data.version + 1
        && (
          resource.data.currentUid == request.auth.uid
          || resource.data.currentUid == null
        );
    }

    function canDeleteRoom() {
      return signedIn() && request.auth.uid == resource.data.hostUid;
    }

    // ---- Games --------------------------------------------------------------------------

    match /stockMarketRooms/{code} {
      allow read: if canReadRoom();
      allow create: if canCreateRoom(code);
      allow update: if canEditLobby() || canPlayMove();
      allow delete: if canDeleteRoom();
    }
  }
}
